# Atlassian DC Admin — machine-wide default: copy to ~/.config/atlassian-dc-admin/.env.
# A project can override it with its own .atlassian-dc-admin.env (run: atlassian-admin init).
# Real environment variables take precedence. Configure only the products you use.

# ---------------------------------------------------------------- Jira
JIRA_URL=https://jira.example.com
# Personal access token of an administrator: Profile -> Personal Access Tokens -> Create token
JIRA_PAT_TOKEN=
# ...or Basic auth
# JIRA_USERNAME=
# JIRA_PASSWORD=
# JIRA_SSL_VERIFY=true
# JIRA_CA_FILE=/path/to/company-root-ca.pem   # extra trusted roots; keeps verification on
# JIRA_TIMEOUT=60

# ---------------------------------------------------------------- Confluence
CONFLUENCE_URL=https://confluence.example.com
CONFLUENCE_PAT_TOKEN=
# CONFLUENCE_USERNAME=
# CONFLUENCE_PASSWORD=
# CONFLUENCE_SSL_VERIFY=true
# CONFLUENCE_CA_FILE=/path/to/company-root-ca.pem
# CONFLUENCE_TIMEOUT=60

# ---------------------------------------------------------------- Reverse-proxy gateway (optional)
# When a proxy in front of the instance takes the Authorization header for its own Basic auth,
# the PAT travels in a separate header that the proxy turns into "Authorization: Bearer".
# JIRA_PROXY_USER=
# JIRA_PROXY_PASS=
# JIRA_TOKEN_HEADER=X-Atlassian-Pat

# ---------------------------------------------------------------- Output
# ATLASSIAN_MAX_RESPONSE_CHARS=60000

# ---------------------------------------------------------------- Confirmation of changes
# Every executed change is confirmed by you in a dialog or terminal. Only this file (or the skill's .env)
# can turn that off for unattended runs; the same variable in the environment is ignored.
# ATLASSIAN_CONFIRM_MODE=auto        # auto | dialog | tty | none
# ATLASSIAN_CONFIRM_TIMEOUT=110      # seconds the dialog waits
